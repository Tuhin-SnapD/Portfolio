# Public production URL. Canonicals, sitemap, robots.txt, Open Graph and JSON-LD
# all use this value, so it must be the domain you want Google to index.
# Example: https://tuhinchakrabarty.com
NEXT_PUBLIC_SITE_URL=

# Google Search Console > Settings > Ownership verification > HTML tag.
# Paste only the content value: <meta name="google-site-verification" content="THIS PART" />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# EmailJS keys (already defaulted in src/lib/emailjs.ts)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
